# WorkshopFlow Backend Environment Configuration
# Copy this file to .env and fill in your values

# Application
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# SQLite (default for local dev)
DATABASE_URL=sqlite:///./workshopflow.db

# PostgreSQL / Supabase (for production)
# DATABASE_URL=postgresql://user:password@host:5432/workshopflow

# Initial Admin Account (used only during first-run bootstrap)
ADMIN_EMAIL=admin@workshopflow.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Tax rate (percentage, e.g. 18 for 18%)
DEFAULT_TAX_RATE=18
